rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Avatar photos live at a stable per-user path (avatars/{uid}) so a
    // re-upload overwrites the old file instead of piling up orphans.
    // Readable by anyone signed in (avatars show up in other people's
    // chats/search results); writable only by the account it belongs to,
    // and only small image files.
    match /avatars/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
