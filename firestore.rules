rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    // The one hardcoded site admin. Checked against the requester's OWN
    // (immutable) usernameLower, never a self-settable flag, so nobody can
    // grant themselves this by writing a field from devtools.
    function isSiteAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.usernameLower == "theivankoo";
    }

    // username -> uid reservation, used to enforce unique usernames and
    // to look up a chat/transfer target by @username.
    match /usernames/{username} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      // account deletion frees up the username for reuse
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // phone (digits) -> { uid }. Lets others find a person by their exact
    // number and keeps numbers unique (the number may or may not be
    // SMS-verified). Signed-in users only, and only single lookups - the
    // collection cannot be listed.
    match /phones/{phone} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid);
      // Profile fields are self-editable. This does not stop a client from
      // rewriting its own `grams`/`isPremium` directly - real money-grade
      // integrity would need Cloud Functions to own those fields server-side.
      // Fine for a play-currency demo; do not store anything sensitive here.
      allow update: if (isOwner(uid)
          && request.resource.data.username == resource.data.username
          && request.resource.data.usernameLower == resource.data.usernameLower)
        // A transfer credits the RECIPIENT's balance from the sender's own
        // client call (Firestore runs both sides of the transaction under
        // the sender's auth), so a non-owner must be able to raise someone
        // else's `grams` - but only that field, and only upward.
        || (isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["grams"])
          && request.resource.data.grams > resource.data.grams)
        // Site admin: grant/clear a custom badge, or mute someone site-wide -
        // nothing else on someone else's account.
        || (isSiteAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["badge", "mutedGlobally"]));
      allow delete: if isOwner(uid);

      // Private per-user data (chat lock: password hash + which chats are
      // locked/hidden). Only the owner can read or write it.
      match /private/{docId} {
        allow read, write: if isOwner(uid);
      }

      match /transactions/{txId} {
        allow read: if isOwner(uid);
        // A transfer/premium purchase needs to write into BOTH the sender's
        // and the recipient's transaction history in one client call, so
        // any signed-in user may create a doc here as long as they are
        // named as its counterpart (i.e. they are the other side of it).
        allow create: if isOwner(uid)
          || (isSignedIn() && request.resource.data.counterpart == request.auth.uid);
        allow update, delete: if false;
      }
    }

    match /chats/{chatId} {
      function chatData() {
        return get(/databases/$(database)/documents/chats/$(chatId)).data;
      }
      function isChatAdmin() {
        return request.auth.uid in chatData().get('adminUids', []);
      }
      // A channel is a chat with isChannel: true - only its admins may
      // post; a plain group or direct chat lets every member post.
      function canPostIn() {
        return chatData().get('isChannel', false) != true || isChatAdmin();
      }

      // `resource == null` covers the "does this chat already exist"
      // probe a client makes before creating a new direct chat: the doc
      // isn't there yet, so there is no membership to check.
      allow read: if isSignedIn() && (resource == null || request.auth.uid in resource.data.memberUids);
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.memberUids
        // whoever creates a channel must be listed as one of its admins
        && (request.resource.data.isChannel != true || request.auth.uid in request.resource.data.adminUids);
      // An "addition" update only ever grows memberUids (no one dropped),
      // leaves adminUids untouched, and only writes memberUids/memberProfiles -
      // i.e. it can only be someone inviting people in, never a kick/promote.
      function isMemberAddition() {
        return request.resource.data.memberUids.hasAll(resource.data.memberUids)
          && request.resource.data.adminUids == resource.data.adminUids
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["memberUids", "memberProfiles"]);
      }
      // `readBy` maps uid -> when they last read; a member may only touch
      // their OWN entry.
      function readByChangeOk() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(["readBy"])
          || request.resource.data.readBy.diff(resource.data.get('readBy', {})).affectedKeys().hasOnly([request.auth.uid]);
      }
      // Leaving yourself: your uid disappears from memberUids/adminUids and
      // nothing else about the member list changes.
      function isSelfLeave() {
        return request.resource.data.memberUids.toSet() == resource.data.memberUids.toSet().difference([request.auth.uid].toSet())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["memberUids", "adminUids", "memberProfiles"]);
      }
      // Pinning/unpinning a message: any member in a direct chat, admins
      // only in a group/channel (same bar as renaming/kicking there).
      function isPinChange() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["pinnedMessageId"]);
      }
      allow update: if isSignedIn() && request.auth.uid in resource.data.memberUids
        && (
          // any member may bump the "last message" preview when sending and
          // mark the chat read for themselves
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["updatedAt", "lastMessage", "readBy"])
            && readByChangeOk())
          // any member may invite more people into a plain group; channels
          // need admin rights even just to invite
          || (resource.data.isChannel != true && isMemberAddition())
          // any member may leave a group/channel on their own
          || isSelfLeave()
          || (isPinChange() && (resource.data.isGroup != true || request.auth.uid in resource.data.adminUids))
          // kicking someone, promoting/demoting, renaming, ... needs admin
          // rights on both groups and channels
          || request.auth.uid in resource.data.adminUids
        );
      allow delete: if false;

      function isChatMuted() {
        return request.auth.uid in chatData().get('mutedUids', []);
      }
      function isGloballyMuted() {
        return exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('mutedGlobally', false) == true;
      }

      match /messages/{messageId} {
        allow read: if isSignedIn() && request.auth.uid in chatData().memberUids;
        allow create: if isSignedIn()
          && request.auth.uid in chatData().memberUids
          && request.resource.data.senderUid == request.auth.uid
          && canPostIn()
          && !isChatMuted()
          && !isGloballyMuted();
        // A poll vote may only touch `poll.votes` - the question/options
        // text must come through unchanged, so voting can never be used to
        // rewrite what the poll actually says.
        function pollVoteOk() {
          return !('poll' in request.resource.data)
            || (request.resource.data.poll.question == resource.data.poll.question
              && request.resource.data.poll.options == resource.data.poll.options);
        }
        // Members may change a message's `reactions` map (emoji -> list of
        // uids) or vote on its `poll`; only the author may edit its text.
        // Sender and time are immutable.
        allow update: if isSignedIn()
          && request.auth.uid in chatData().memberUids
          && (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(["reactions"])
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["poll"]) && pollVoteOk())
            // the author may edit their own message text
            || (resource.data.senderUid == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["content", "editedAt"]))
          );
        // Anyone may delete their own message; the site admin may delete
        // any message anywhere, for moderation.
        allow delete: if isSignedIn() && (resource.data.senderUid == request.auth.uid || isSiteAdmin());
      }

      match /typing/{uid} {
        allow read: if isSignedIn() && request.auth.uid in chatData().memberUids;
        allow write: if isOwner(uid);
      }
    }
  }
}
