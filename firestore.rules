rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    // The one hardcoded site admin. Checked against the requester's OWN
    // (immutable) usernameLower, never a self-settable flag, so nobody can
    // grant themselves this by writing a field from devtools.
    function isSiteAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.usernameLower == "theivankoo";
    }

    // Moderators are appointed by the site admin through users/{uid}.siteRole
    // ("moderator"). The field is admin-only (see the users rules below), so
    // it cannot be self-granted. A moderator can mute users, delete messages
    // and close reports - nothing else.
    function isModerator() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('siteRole', null) == 'moderator';
    }

    // username -> uid reservation, used to enforce unique usernames and
    // to look up a chat/transfer target by @username.
    match /usernames/{username} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      // account deletion frees up the username for reuse
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // phone (digits) -> { uid }. Lets others find a person by their exact
    // number and keeps numbers unique (the number may or may not be
    // SMS-verified). Signed-in users only, and only single lookups - the
    // collection cannot be listed.
    match /phones/{phone} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if isSignedIn();
      // A profile may only claim a username it has actually reserved: the
      // reservation (usernames/{usernameLower} -> this uid) is written in the
      // same transaction, hence getAfter(). Without this check anyone could
      // create their profile with usernameLower "theivankoo" and thereby pass
      // isSiteAdmin().
      allow create: if isOwner(uid)
        && request.resource.data.usernameLower is string
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameLower)).data.uid == uid
        && !('siteRole' in request.resource.data);
      // Profile fields are self-editable. This does not stop a client from
      // rewriting its own `grams`/`isPremium` directly - real money-grade
      // integrity would need Cloud Functions to own those fields server-side.
      // Fine for a play-currency demo; do not store anything sensitive here.
      allow update: if (isOwner(uid)
          && request.resource.data.username == resource.data.username
          && request.resource.data.usernameLower == resource.data.usernameLower
          // the moderator role can only be handed out by the site admin
          && request.resource.data.get('siteRole', null) == resource.data.get('siteRole', null))
        // A transfer credits the RECIPIENT's balance from the sender's own
        // client call (Firestore runs both sides of the transaction under
        // the sender's auth), so a non-owner must be able to raise someone
        // else's `grams` - but only that field, and only upward.
        || (isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["grams"])
          && request.resource.data.grams > resource.data.grams
          // one transfer is capped at 1 000 000 on the client (transferGrams)
          && request.resource.data.grams - resource.data.grams <= 1000000)
        // Site admin: grant/clear a custom badge, mute someone site-wide,
        // grant/revoke a subscription or appoint/dismiss a moderator -
        // nothing else on someone else's account.
        || (isSiteAdmin() && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["badge", "mutedGlobally", "isPremium", "premiumUntil", "premiumTier", "siteRole"]))
        // Moderator: only the site-wide mute, and never on the admin or on
        // another moderator.
        || (isModerator()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["mutedGlobally"])
          && resource.data.usernameLower != "theivankoo"
          && resource.data.get('siteRole', null) != 'moderator');
      allow delete: if isOwner(uid);

      // Private per-user data (chat lock: password hash + which chats are
      // locked/hidden). Only the owner can read or write it.
      match /private/{docId} {
        allow read, write: if isOwner(uid);
      }

      match /transactions/{txId} {
        allow read: if isOwner(uid);
        // A transfer/premium purchase needs to write into BOTH the sender's
        // and the recipient's transaction history in one client call, so
        // any signed-in user may create a doc here as long as they are
        // named as its counterpart (i.e. they are the other side of it) -
        // and then it can only be a plain incoming transfer with a positive
        // amount, exactly the shape transferGrams() writes for the recipient.
        function incomingTransferOk() {
          let d = request.resource.data;
          return isSignedIn()
            && d.keys().hasOnly(['amount', 'type', 'note', 'counterpart', 'counterpartUsername', 'createdAt'])
            && d.keys().hasAll(['amount', 'type', 'counterpart', 'createdAt'])
            && d.counterpart == request.auth.uid
            && d.counterpart != uid
            && d.type == 'transfer'
            && d.amount is number && d.amount > 0 && d.amount <= 1000000
            && (d.get('note', null) == null || (d.note is string && d.note.size() <= 500))
            && (d.get('counterpartUsername', null) == null || (d.counterpartUsername is string && d.counterpartUsername.size() <= 100))
            && d.createdAt == request.time;
        }
        allow create: if isOwner(uid) || incomingTransferOk();
        allow update, delete: if false;
      }
    }

    // User reports. One document per (reporter, target, message) - the id is
    // forced by the rules, so a repeat report hits an existing doc, becomes
    // an `update`, and is denied to everyone but the site admin. That is the
    // anti-spam: no Cloud Functions needed.
    match /reports/{reportId} {
      function reportOk() {
        let d = request.resource.data;
        return d.keys().hasOnly(['reporterUid', 'targetUid', 'chatId', 'messageId', 'messageText', 'reason', 'comment', 'createdAt', 'status'])
          && d.keys().hasAll(['reporterUid', 'targetUid', 'reason', 'createdAt', 'status'])
          && d.reporterUid == request.auth.uid
          && d.targetUid is string && d.targetUid.size() > 0
          && d.reporterUid != d.targetUid
          && d.reason in ['spam', 'abuse', 'scam', 'illegal', 'other']
          && d.status == 'open'
          && d.createdAt == request.time
          && (!('chatId' in d) || (d.chatId is string && d.chatId.size() <= 200))
          && (!('messageId' in d) || (d.messageId is string && d.messageId.size() > 0 && d.messageId.size() <= 200))
          && (!('messageText' in d) || (d.messageText is string && d.messageText.size() <= 500))
          && (!('comment' in d) || (d.comment is string && d.comment.size() <= 500))
          && reportId == d.reporterUid + '_' + d.targetUid + '_' + d.get('messageId', 'user');
      }
      allow create: if isSignedIn() && reportOk();
      allow read: if isSiteAdmin() || isModerator();
      allow update: if isSiteAdmin()
        || (isModerator() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));
      allow delete: if isSiteAdmin();
    }

    match /chats/{chatId} {
      function chatData() {
        return get(/databases/$(database)/documents/chats/$(chatId)).data;
      }
      function isChatAdmin() {
        return request.auth.uid in chatData().get('adminUids', []);
      }
      // A channel is a chat with isChannel: true - only its admins may
      // post; a plain group or direct chat lets every member post.
      function canPostIn() {
        return chatData().get('isChannel', false) != true || isChatAdmin();
      }

      // `resource == null` covers the "does this chat already exist"
      // probe a client makes before creating a new direct chat: the doc
      // isn't there yet, so there is no membership to check.
      // A public group/channel (isPublic: true) is readable by any signed-in
      // user so it can be found in search and previewed before joining; its
      // messages stay members-only. A doc without the flag is private.
      allow read: if isSignedIn() && (resource == null
        || request.auth.uid in resource.data.memberUids
        || resource.data.isPublic == true);
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.memberUids
        // whoever creates a channel must be listed as one of its admins
        && (request.resource.data.isChannel != true || request.auth.uid in request.resource.data.adminUids);
      // An "addition" update only ever grows memberUids (no one dropped),
      // leaves adminUids untouched, and only writes memberUids/memberProfiles -
      // i.e. it can only be someone inviting people in, never a kick/promote.
      function isMemberAddition() {
        return request.resource.data.memberUids.hasAll(resource.data.memberUids)
          && request.resource.data.adminUids == resource.data.adminUids
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["memberUids", "memberProfiles"]);
      }
      // `readBy` maps uid -> when they last read; a member may only touch
      // their OWN entry.
      // The entry must be the server time (the client writes serverTimestamp()).
      function readByChangeOk() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(["readBy"])
          || (request.resource.data.readBy.diff(resource.data.get('readBy', {})).affectedKeys().hasOnly([request.auth.uid])
            && request.resource.data.readBy[request.auth.uid] == request.time);
      }
      // `deliveredTo` is the same shape as `readBy` (uid -> when that member's
      // client received the latest message); a member may only touch their
      // OWN entry.
      function deliveredToChangeOk() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(["deliveredTo"])
          || (request.resource.data.deliveredTo.diff(resource.data.get('deliveredTo', {})).affectedKeys().hasOnly([request.auth.uid])
            && request.resource.data.deliveredTo[request.auth.uid] == request.time);
      }
      // The chat-list preview. Two legitimate writers:
      //  - sendMessage(): lastMessage.senderUid is the sender and its
      //    createdAt is the server time (same batch => same request.time);
      //  - editMessage()/deleteMessage() fixing the preview: lastMessage is
      //    then the ONLY key touched, keeps the older message's time (which
      //    can't be in the future) and may name another author, or be null.
      function lastMessageChangeOk() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        let lm = request.resource.data.get('lastMessage', null);
        return !changed.hasAny(["lastMessage"])
          || lm == null
          || (lm is map
            && lm.keys().hasOnly(['content', 'senderUid', 'createdAt'])
            && lm.content is string && lm.content.size() <= 4100
            && lm.senderUid is string
            && ((lm.senderUid == request.auth.uid && lm.createdAt == request.time)
              || (changed.hasOnly(["lastMessage"]) && lm.createdAt is timestamp && lm.createdAt <= request.time)));
      }
      function updatedAtChangeOk() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(["updatedAt"])
          || request.resource.data.updatedAt == request.time;
      }
      // Leaving yourself: your uid disappears from memberUids/adminUids and
      // nothing else about the member list changes.
      function isSelfLeave() {
        return request.resource.data.memberUids.toSet() == resource.data.memberUids.toSet().difference([request.auth.uid].toSet())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["memberUids", "adminUids", "memberProfiles"]);
      }
      // Pinning/unpinning a message: any member in a direct chat, admins
      // only in a group/channel (same bar as renaming/kicking there).
      function isPinChange() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["pinnedMessageId"]);
      }
      // Joining a group/channel yourself. Touches nothing but memberUids
      // (gains exactly your own uid) and your own memberProfiles entry. Public
      // chats are open to anyone; a private one needs the invite code, which
      // the joiner sends inside their own profile entry (`joinCode`) and which
      // must equal the chat's stored `inviteCode` - non-members cannot read
      // that, so only someone holding the link can produce it.
      function isSelfJoin() {
        let me = request.auth.uid;
        return !(me in resource.data.memberUids)
          && resource.data.get('isGroup', false) == true
          && request.resource.data.memberUids.toSet() == resource.data.memberUids.toSet().union([me].toSet())
          && request.resource.data.adminUids == resource.data.adminUids
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["memberUids", "memberProfiles"])
          && request.resource.data.memberProfiles.diff(resource.data.get('memberProfiles', {})).affectedKeys().hasOnly([me])
          && (resource.data.get('isPublic', false) == true
            || (resource.data.get('inviteCode', null) != null
              && request.resource.data.memberProfiles[me].get('joinCode', null) == resource.data.inviteCode));
      }
      allow update: if isSignedIn() && isSelfJoin();
      allow update: if isSignedIn() && request.auth.uid in resource.data.memberUids
        && (
          // any member may bump the "last message" preview when sending and
          // mark the chat read / delivered for themselves
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["updatedAt", "lastMessage", "readBy", "deliveredTo"])
            && readByChangeOk()
            && deliveredToChangeOk()
            && lastMessageChangeOk()
            && updatedAtChangeOk())
          // any member may invite more people into a plain group; channels
          // need admin rights even just to invite
          || (resource.data.isChannel != true && isMemberAddition())
          // any member may leave a group/channel on their own
          || isSelfLeave()
          || (isPinChange() && (resource.data.isGroup != true || request.auth.uid in resource.data.adminUids))
          // kicking someone, promoting/demoting, renaming, ... needs admin
          // rights on both groups and channels
          || request.auth.uid in resource.data.adminUids
        );
      allow delete: if false;

      function isChatMuted() {
        return request.auth.uid in chatData().get('mutedUids', []);
      }
      function isGloballyMuted() {
        return exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('mutedGlobally', false) == true;
      }

      match /messages/{messageId} {
        // Shape/size of a new message, mirroring sendMessage(): text and poll
        // questions are capped like MAX_MESSAGE_LENGTH (4000), an image is a
        // base64 data URL the client keeps under ~700 KB (cap 900 000 chars
        // keeps the doc below Firestore's 1 MiB limit). createdAt is server time.
        function messageShapeOk() {
          let d = request.resource.data;
          return d.content is string
            && d.type in ['text', 'image', 'poll']
            && ((d.type == 'image' && d.content.size() <= 900000)
              || (d.type != 'image' && d.content.size() <= 4000))
            && d.createdAt == request.time;
        }
        allow read: if isSignedIn() && request.auth.uid in chatData().memberUids;
        allow create: if isSignedIn()
          && request.auth.uid in chatData().memberUids
          && request.resource.data.senderUid == request.auth.uid
          && messageShapeOk()
          && canPostIn()
          && !isChatMuted()
          && !isGloballyMuted();
        // A poll vote may only touch `poll.votes` - the question/options
        // text must come through unchanged, so voting can never be used to
        // rewrite what the poll actually says.
        function pollVoteOk() {
          return !('poll' in request.resource.data)
            || (request.resource.data.poll.question == resource.data.poll.question
              && request.resource.data.poll.options == resource.data.poll.options);
        }
        // Members may change a message's `reactions` map (emoji -> list of
        // uids) or vote on its `poll`; only the author may edit its text.
        // Sender and time are immutable.
        allow update: if isSignedIn()
          && request.auth.uid in chatData().memberUids
          && (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(["reactions"])
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["poll"]) && pollVoteOk())
            // the author may edit their own message text
            || (resource.data.senderUid == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["content", "editedAt"]))
          );
        // Anyone may delete their own message; the admins of a group/channel
        // may clean up their chat, and the site admin and moderators may
        // delete any message anywhere, for moderation.
        allow delete: if isSignedIn()
          && (resource.data.senderUid == request.auth.uid || isChatAdmin() || isSiteAdmin() || isModerator());
      }

      match /typing/{uid} {
        allow read: if isSignedIn() && request.auth.uid in chatData().memberUids;
        // only members may leave typing marks in a chat
        allow write: if isOwner(uid) && request.auth.uid in chatData().memberUids;
      }
    }
  }
}
